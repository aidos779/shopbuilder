{
  "name": "shopbuilder",
  "version": "2.0.0",
  "description": "ShopBuilder — Enterprise Multi-Tenant E-Commerce Backend",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "worker": "node src/worker.js",
    "dev": "nodemon src/server.js",
    "test": "DATABASE_URL=postgresql://shopbuilder:shopbuilder_pass@localhost:5432/shopbuilder JWT_SECRET=test_jwt_secret_for_local_tests_123456 jest --runInBand --forceExit",
    "db:migrate": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "export:openapi": "node scripts/export-openapi.js",
    "verify:email": "node scripts/verify-email-provider.js"
  },
  "dependencies": {
    "@prisma/client": "^5.10.0",
    "bcrypt": "^5.1.1",
    "bullmq": "^5.76.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.3",
    "express-rate-limit": "^7.2.0",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^8.0.7",
    "prisma": "^5.10.0",
    "rate-limit-redis": "^4.2.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "js-yaml": "^4.1.1",
    "nodemon": "^3.1.0",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ]
  }
}
