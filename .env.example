# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://shopbuilder:shopbuilder_pass@localhost:5432/shopbuilder
POSTGRES_PASSWORD=shopbuilder_pass_change_me

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ── JWT ───────────────────────────────────────────────────────────────────────
# Must be at least 32 characters; use a cryptographically random value
JWT_SECRET=change_this_to_a_long_random_secret_in_production

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
HOST=0.0.0.0
# Public backend URL used by Swagger and the frontend container in production
API_URL=http://localhost:3000
# Comma-separated explicit browser origins. Do not use "*" in production.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
NODE_ENV=development

# ── Email (SMTP — works with Mailtrap, SendGrid, SES, etc.) ───────────────────
EMAIL_HOST=smtp.mailtrap.io
EMAIL_PORT=587
EMAIL_USER=your_mailtrap_username
EMAIL_PASS=your_mailtrap_password
EMAIL_FROM="ShopBuilder" <noreply@shopbuilder.io>
EMAIL_TEST_TO=your_verified_test_inbox@example.com

# ── Frontend (used in email links) ────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ── Feature flags ─────────────────────────────────────────────────────────────
# Set to "true" in production to block login until email is verified
REQUIRE_EMAIL_VERIFICATION=true
# Set to "true" for worker deployments so missing SMTP config fails fast
REQUIRE_EMAIL_CONFIG=false
